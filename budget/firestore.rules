rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function hDoc(h) { return get(/databases/$(db)/documents/households/$(h)); }
    function mPath(h) { return /databases/$(db)/documents/households/$(h)/members/$(request.auth.uid); }
    function isMember(h) { return signedIn() && exists(mPath(h)); }
    function me(h) { return get(mPath(h)).data; }
    function isOwner(h) { return isMember(h) && me(h).role == 'owner'; }
    function memPath(h, u) { return /databases/$(db)/documents/households/$(h)/members/$(u); }
    // Hand-over: the new owner is a member, and in the same batch gets the owner role while the old owner becomes a member
    function handsOver(h) {
      return exists(memPath(h, request.resource.data.ownerId))
        && getAfter(memPath(h, request.resource.data.ownerId)).data.role == 'owner'
        && getAfter(mPath(h)).data.role == 'member';
    }

    // Personal data (accounts, settings, loans, deposits, pending, learned): owner only
    match /users/{uid}/{document=**} {
      allow read, write: if isSelf(uid);
    }

    // Invites: read by exact code only, created by the household owner
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isOwner(request.resource.data.householdId);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if false;
    }

    match /households/{h} {
      allow read: if isMember(h);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(h)
        && (request.resource.data.ownerId == resource.data.ownerId || handsOver(h));
      allow delete: if isOwner(h);

      match /members/{m} {
        allow read: if isMember(h);
        allow create: if isSelf(m) && (
          (request.resource.data.role == 'owner'
            && hDoc(h).data.ownerId == request.auth.uid
            && !exists(/databases/$(db)/documents/households/$(h)/members/$(m)))
          ||
          (request.resource.data.role == 'member'
            && request.resource.data.canDelete == false
            && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.householdId == h)
        );
        allow update: if isOwner(h)
          || (isSelf(m)
              && request.resource.data.role == resource.data.role
              && request.resource.data.canDelete == resource.data.canDelete);
        allow delete: if (isOwner(h) && m != request.auth.uid) || (isSelf(m) && me(h).role != 'owner');
      }

      // Balances live in their own docs so the owner can hide them from others
      match /balances/{a} {
        allow read: if isMember(h)
          && (resource.data.ownerId == request.auth.uid || hDoc(h).data.showBalances == true);
        allow create: if isMember(h) && request.resource.data.ownerId == request.auth.uid;
        allow update, delete: if isMember(h) && resource.data.ownerId == request.auth.uid;
      }

      match /categories/{c} {
        allow read, write: if isMember(h);
      }

      // Everyone sees transactions; private ones only the owner
      match /transactions/{t} {
        allow read: if isMember(h)
          && (resource.data.isPrivate == false || resource.data.ownerId == request.auth.uid);
        allow create: if isMember(h)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.isPrivate is bool;
        allow update: if isMember(h)
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isMember(h)
          && (resource.data.ownerId == request.auth.uid || me(h).canDelete == true);
      }

      // Shared loans and fixed deposits: one document per item (see householdSharingRules.dart).
      // Fields: kind, ownerUid, localId, visibleTo (uids besides the owner), membersCanEdit, _u, payload.
      // Private by default: only the owner and the people listed in visibleTo can read an item.
      match /sharedItems/{i} {
        // Same checks as _audienceError() in the app: a list of at most 7 other members, no duplicates.
        function audienceOk(d) {
          return d.visibleTo is list
            && d.visibleTo.size() <= 7
            && d.membersCanEdit is bool
            && !(d.ownerUid in d.visibleTo)
            && d.visibleTo.toSet().size() == d.visibleTo.size()
            && (d.visibleTo.size() < 1 || exists(memPath(h, d.visibleTo[0])))
            && (d.visibleTo.size() < 2 || exists(memPath(h, d.visibleTo[1])))
            && (d.visibleTo.size() < 3 || exists(memPath(h, d.visibleTo[2])))
            && (d.visibleTo.size() < 4 || exists(memPath(h, d.visibleTo[3])))
            && (d.visibleTo.size() < 5 || exists(memPath(h, d.visibleTo[4])))
            && (d.visibleTo.size() < 6 || exists(memPath(h, d.visibleTo[5])))
            && (d.visibleTo.size() < 7 || exists(memPath(h, d.visibleTo[6])));
        }
        function shapeOk(d) {
          return d.kind in ['loan', 'fd']
            && d.ownerUid is string
            && d.localId is string && d.localId.size() > 0
            && d._u is number
            && d.payload is map
            && i.matches(d.kind + '-' + d.ownerUid + '-.+');
        }

        // Two queries are allowed: ownerUid == me, and visibleTo array-contains me.
        allow read: if isMember(h)
          && (resource.data.ownerUid == request.auth.uid
              || request.auth.uid in resource.data.visibleTo);

        allow create: if isMember(h)
          && request.resource.data.ownerUid == request.auth.uid
          && shapeOk(request.resource.data)
          && audienceOk(request.resource.data);

        // The owner changes anything except who the owner is, what kind it is and its local id.
        // Somebody else may change only the details (payload and _u), and only when the owner allowed it.
        allow update: if isMember(h)
          && shapeOk(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.localId == resource.data.localId
          && (
            (resource.data.ownerUid == request.auth.uid && audienceOk(request.resource.data))
            ||
            (resource.data.membersCanEdit == true
              && request.auth.uid in resource.data.visibleTo
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', '_u']))
          );

        // Only the owner of the item deletes it. The household owner may also clear away the items of
        // a person who was removed.
        allow delete: if isMember(h)
          && (resource.data.ownerUid == request.auth.uid || isOwner(h));
      }
    }
  }
}
