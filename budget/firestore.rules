rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function hDoc(h) { return get(/databases/$(db)/documents/households/$(h)); }
    function mPath(h) { return /databases/$(db)/documents/households/$(h)/members/$(request.auth.uid); }
    function isMember(h) { return signedIn() && exists(mPath(h)); }
    function me(h) { return get(mPath(h)).data; }
    function isOwner(h) { return isMember(h) && me(h).role == 'owner'; }

    // ---------- personal data (owner-only, syncs across the user's devices) ----------
    match /users/{uid} {
      allow read, write: if isSelf(uid);

      // real account details: name, number, type, bank
      match /accounts/{id}   { allow read, write: if isSelf(uid); }
      // settings, fonts, theme, preferences
      match /settings/{id}   { allow read, write: if isSelf(uid); }
      // loans and fixed deposits
      match /loans/{id}      { allow read, write: if isSelf(uid); }
      match /deposits/{id}   { allow read, write: if isSelf(uid); }
      // SMS review queue from Ping (unconfirmed transactions)
      match /pending/{id}    { allow read, write: if isSelf(uid); }
      // learned corrections (merchant -> category/account)
      match /learned/{id}    { allow read, write: if isSelf(uid); }
    }

    // ---------- invites ----------
    // Owner creates an invite code; a joining user reads it by exact code only.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isOwner(request.resource.data.householdId);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if false;
    }

    // ---------- household ----------
    match /households/{h} {
      allow read: if isMember(h);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(h)
        && request.resource.data.ownerId == resource.data.ownerId;   // owner can't be changed here
      allow delete: if isOwner(h);

      // members
      match /members/{m} {
        allow read: if isMember(h);

        // first member = the creator becoming owner
        allow create: if isSelf(m) && (
          (request.resource.data.role == 'owner'
            && hDoc(h).data.ownerId == request.auth.uid
            && !exists(/databases/$(db)/documents/households/$(h)/members/$(m)))
          ||
          // joining with a valid invite code
          (request.resource.data.role == 'member'
            && request.resource.data.canDelete == false
            && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.householdId == h)
        );

        // owner manages roles and delete permission; a member can edit own display name only
        allow update: if isOwner(h)
          || (isSelf(m)
              && request.resource.data.role == resource.data.role
              && request.resource.data.canDelete == resource.data.canDelete);

        // owner removes anyone (except self); members can leave
        allow delete: if (isOwner(h) && m != request.auth.uid) || (isSelf(m) && me(h).role != 'owner');
      }

      // balances: separate docs so they can be hidden
      match /balances/{a} {
        allow read: if isMember(h)
          && (resource.data.ownerId == request.auth.uid || hDoc(h).data.showBalances == true);
        allow create: if isMember(h) && request.resource.data.ownerId == request.auth.uid;
        allow update, delete: if isMember(h) && resource.data.ownerId == request.auth.uid;
      }

      // shared categories
      match /categories/{c} {
        allow read: if isMember(h);
        allow write: if isMember(h);
      }

      // transactions: everyone sees them, private ones only the owner
      match /transactions/{t} {
        allow read: if isMember(h)
          && (resource.data.isPrivate == false || resource.data.ownerId == request.auth.uid);

        allow create: if isMember(h)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.isPrivate is bool;

        allow update: if isMember(h)
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId;

        allow delete: if isMember(h)
          && (resource.data.ownerId == request.auth.uid || me(h).canDelete == true);
      }
    }
  }
}
